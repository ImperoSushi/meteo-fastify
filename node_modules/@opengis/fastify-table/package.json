{
  "name": "@opengis/fastify-table",
  "version": "1.5.9",
  "type": "module",
  "description": "core-plugins",
  "keywords": [
    "fastify",
    "table",
    "crud",
    "pg",
    "backend"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./index.js": "./dist/index.js",
    "./utils.js": "./dist/utils.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "clean": "tsc -b --clean",
    "build": "tsc -b --clean && tsc && copyfiles server/plugins/grpc/utils/*.proto dist && copyfiles server/migrations/*.sql dist",
    "prod": "NODE_ENV=production bun dist/server",
    "patch": "npm version patch && git push && npm publish",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test": "node --test",
    "compress": "node compress.js",
    "dev1": "set NODE_ENV=local&& node server.js",
    "dev": "NODE_ENV=production bun start",
    "start": "bun server"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.879.0",
    "@aws-sdk/lib-storage": "3.879.0",
    "@fastify/http-proxy": "11.1.2",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "10.3.0",
    "@grpc/grpc-js": "1.10.6",
    "@grpc/proto-loader": "0.7.12",
    "better-sqlite3": "12.2.0",
    "copyfiles": "^2.4.1",
    "dotenv": "16.5.0",
    "fastify": "5.3.3",
    "fastify-plugin": "5.0.1",
    "handlebars": "4.7.8",
    "image-size": "1.2.0",
    "ioredis": "5.3.2",
    "js-yaml": "4.1.0",
    "markdown-it": "14.1.0",
    "pg": "8.11.3",
    "pino": "9.5.0",
    "pino-abstract-transport": "2.0.0",
    "promised-handlebars": "2.0.1",
    "qrcode": "1.5.4",
    "uglify-js": "3.19.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.2.21",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.35.0",
    "eslint-config-airbnb-extended": "^2.3.1",
    "ts-migrate": "^0.1.35",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "author": "Softpro",
  "license": "ISC"
}
